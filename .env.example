# TraderAIG Environment Configuration

# PostgreSQL (leave POSTGRES_HOST EMPTY to use local SQLite; set only when a server runs)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=traderaig
POSTGRES_USER=traderaig
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# MT5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# ---- MT5 terminal instance to develop against ----
# Two isolated portable instances share this repo's code:
#   DEV  D:\One\mt5-dev          <- all development & testing here
#   LIVE D:\One\mt5-portable     <- frozen production, synced only after proof
# Switch runtime by editing MT5_TERMINAL_PATH (dev is the working default).
MT5_TERMINAL_PATH=D:\One\mt5-dev\terminal64.exe
# Trading universe (hierarchy): BTC is PRIMARY on BOTH rails — MT5 broker with a
# live verified BTCUSD symbol (symbols_get(): 60 symbols, trade_mode=full, 0.01-100
# lots) and the CEX rail (BTCUSDT on Binance/Bybit/OKX; paper/watch by default) —
# then gold SECOND on MT5, then pairs per choice = editable lists below.
# NOTE: the local symbol cache (Bases/Default/Symbols/*.dat) is stale; the authority
# is the live terminal query (symbols_get()). MT5 catalog selection (per operator
# choice): BTCUSD, XAUUSD, EURUSD, GBPUSD, USDJPY, USDCAD, AUDUSD, NZDUSD, USDCHF,
# USDCNH, USDSEK, SP500m, NVDA, AMD, MSFT, INTC — see UPDATE.md annex C
CEX_SYMBOLS=BTCUSDT,ETHUSDT
# Symbols traded live by the LiveEngine (comma separated) + loop interval (s)
MT5_SYMBOLS=BTCUSD,XAUUSD
MT5_INTERVAL=30

# Pilot sizing policy
TRADERAIG_SIZING_MODE=dynamic
TRADERAIG_PILOT_MAX_SIZE=0.10
TRADERAIG_SINGLE_SOURCE_SIZE_MULTIPLIER=0.50
# Optional fixed override when TRADERAIG_SIZING_MODE=fixed
TRADERAIG_FIXED_SIZE=

# Pilot macro runtime hints
TRADERAIG_MACRO_RISK_MODE=neutral
TRADERAIG_DXY_TREND=flat
TRADERAIG_RATES_UP=0

# Opportunity Engine (Phase B — 27.10/28.11: opportunity != trade)
# 0 (default) = the pipeline keeps its governed auto-execution; every screened
#               setup is still recorded and surfaced on the Opportunity board.
# 1           = operator-confirmation: a qualified opportunity does NOT execute
#               until the operator approves it (POST /opportunities/{id}/approve,
#               `tradraig opportunity approve`); the pipeline then executes it on
#               the next bar with a fresh Risk Governor check.
TRADERAIG_OPPORTUNITY_GATE=0
# Optional durable-board path override (default decision/data/opportunities.json)
TRADERAIG_OPPORTUNITY_BOARD=

# API
API_HOST=0.0.0.0
API_PORT=8000

# Risk defaults
RISK_MAX_PER_TRADE=0.01
RISK_MAX_DAILY_LOSS=0.03
RISK_MAX_DRAWDOWN=0.10
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_LEVERAGE=10.0
RISK_REQUIRE_STOP_LOSS=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Billing & Wallet (sandbox-first; live gated OFF by default)
#   sandbox (default) = deterministic in-process wallet ledger, zero network
#   live     = real money; ONLY when PAYMENTS_LIVE_ALLOWED=1 AND a key exists
PAYMENTS_MODE=sandbox
PAYMENTS_LIVE_ALLOWED=0
PAYMENTS_PROVIDER=sandbox
# Stripe (live): sk_test_/sk_live_ secret + webhook signing secret
PAYMENTS_STRIPE_SECRET_KEY=
PAYMENTS_STRIPE_WEBHOOK_SECRET=
# Pi Network (registered, live not wired yet — needs the server-side SDK)
PAYMENTS_PI_API_KEY=
PAYMENTS_PI_WALLET_KEY=

# CEX venue keys (paper default; live/trade stays OFF unless CEX_LIVE_ALLOWED=1)
#   CEX_OKX_*       -> main (live) slot, mode=live
#   CEX_OKX_DEMO_*  -> OKX Demo Trading slot, mode=testnet (x-simulated-trading:1);
#                      a demo key has NO IP binding and needs no production KYC.
#                      TESTNET uses ONLY the demo slot, never the live one.
CEX_OKX_API_KEY=
CEX_OKX_API_SECRET=
CEX_OKX_PASSPHRASE=
CEX_OKX_BROKER_ID=
CEX_OKX_DEMO_API_KEY=f7e78f12-6a5d-4111-8de6-e67e1e82dab1
CEX_OKX_DEMO_API_SECRET=4F95BFD26BC431F13B5B89881D57F4EC
CEX_OKX_DEMO_PASSPHRASE=MOHKHas123!@#
